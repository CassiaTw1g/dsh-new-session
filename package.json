{
  "name": "dsh-new-session",
  "version": "0.1.0",
  "description": "给 DeepSeek Harness 的模型一个真正能用的「新开对话」工具：在当前工作区建会话、投递交接消息、带上一段对话的只读引用，并把 Web UI 自动切过去。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CassiaTw1g/dsh-new-session.git"
  },
  "homepage": "https://github.com/CassiaTw1g/dsh-new-session#readme",
  "bugs": {
    "url": "https://github.com/CassiaTw1g/dsh-new-session/issues"
  },
  "author": "CassiaTw1g",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "tools",
    "test",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "new-session",
    "new-conversation",
    "session"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "engines": {
    "node": ">=22"
  }
}
